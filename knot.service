[Unit]
Description=KNot - Webhook to SMTP Mail
#This is an example. Edit it to your needs.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/knot
ExecStart=/home/knot/run.sh
Restart=on-failure
RestartSec=5
# 78 (EX_CONFIG): the config file was rejected. Fix it, then run `systemctl restart knot`.
RestartPreventExitStatus=78
# 143: the JVM's exit code after a SIGTERM (systemctl stop), which is a clean stop, not a failure
SuccessExitStatus=143
User=knot

[Install]
WantedBy=multi-user.target
