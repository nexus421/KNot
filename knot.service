[Unit]
Description=KNot - Webhook to SMTP Mail
#This is an example. Edit it to your needs.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/
ExecStart=/root/run.sh
Restart=on-failure
RestartSec=5
# 78 (EX_CONFIG): the config file was rejected or the address could not be bound - fix it, then `systemctl restart knot`
RestartPreventExitStatus=78
# 143: the JVM's exit code after a SIGTERM (systemctl stop), which is a clean stop, not a failure
SuccessExitStatus=143
User=root

[Install]
WantedBy=multi-user.target
